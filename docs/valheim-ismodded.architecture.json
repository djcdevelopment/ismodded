      "dot": "emerald",
      "title": "The IsModded Fix",
      "items": [
        "Harmony prefix intercepts Achievements.IsCheatedAtAll()",
        "Preserves legitimate cheat detection (console, modifiers, items)",
        "Decouples Game.isModded so modded players earn achievements"
      ]
    },
